  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**EV digital twin: Ather 450X vs Ola S1 Pro.** Pick a scenario and compare vehicles and controller settings. Time axis = seconds since the scenario started (shown as 00:00:SS); adjust the time range for short or long scenarios. Data is simulated; values marked ESTIMATED in the configs are not yet calibrated."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Speed vs target",
      "description": "Closed-loop scenarios show the speed target; open-loop ones (launch, throttle step) have none.",
      "datasource": {
        "type": "postgres",
        "uid": "ev-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ev-timescale"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TIMESTAMPTZ '2000-01-01 00:00:00+00' + t.t_s * INTERVAL '1 second' AS time, r.vehicle_name || ' | ' || r.ctrl AS metric, t.speed_ms * 3.6 AS value FROM ev.telemetry t JOIN ev.runs r ON r.run_id = t.run_id WHERE r.scenario = '$scenario' AND r.vehicle_name IN ($vehicle) AND r.ctrl IN ($ctrl) ORDER BY 1"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "ev-timescale"
          },
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TIMESTAMPTZ '2000-01-01 00:00:00+00' + t.t_s * INTERVAL '1 second' AS time, 'target' AS metric, t.target_ms * 3.6 AS value FROM ev.telemetry t WHERE t.run_id = (SELECT run_id FROM ev.runs WHERE scenario = '$scenario' ORDER BY run_id LIMIT 1) AND t.target_ms IS NOT NULL ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
