          "editorMode": "code",
          "rawSql": "SELECT TIMESTAMPTZ '2000-01-01 00:00:00+00' + t.t_s * INTERVAL '1 second' AS time, r.vehicle_name || ' | ' || r.ctrl || ' shaft' AS metric, t.torque_nm * t.motor_rpm * 2 * PI() / 60.0 AS value FROM ev.telemetry t JOIN ev.runs r ON r.run_id = t.run_id WHERE r.scenario = '$scenario' AND r.vehicle_name IN ($vehicle) AND r.ctrl IN ($ctrl) ORDER BY 1"
