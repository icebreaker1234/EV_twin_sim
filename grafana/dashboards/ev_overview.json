          "rawSql": "SELECT r.vehicle_name AS \"Vehicle\", r.ctrl AS \"Controller\", r.t_0_40_s AS \"0-40 km/h (s)\", r.top_speed_kmph AS \"Top speed (km/h)\", r.wh_per_km AS \"Wh/km\", r.energy_wh AS \"Energy (Wh)\", r.p95_jerk_ms3 AS \"p95 |jerk|\", r.rms_jerk_ms3 AS \"RMS jerk\", r.peak_jerk_ms3 AS \"Peak jerk\", r.peak_accel_ms2 AS \"Peak accel\", r.peak_lean_deg AS \"Peak lean (deg)\", r.jerk_gain AS \"Jerk gain\", r.distance_m AS \"Distance (m)\" FROM ev.runs r WHERE r.scenario = '$scenario' AND r.vehicle_name IN ($vehicle) AND r.ctrl IN ($ctrl) ORDER BY r.vehicle_name, r.ctrl"
        }
      ],
